{
  "casemaster": {
    "name": "casemaster",
    "displayName": "CaseMaster AI",
    "githubRepo": "casemaster-code/casemaster",
    "ecrRepositoryName": "casemaster",
    "containerPort": 8000,
    "healthCheckPath": "/health",
    "healthCheckInterval": 30,
    "healthCheckTimeout": 5,
    "healthyThresholdCount": 2,
    "unhealthyThresholdCount": 3,
    "environments": ["dev"],
    "domains": {
      "dev": "api-dev.casemaster.co.in"
    },
    "alarmEmail": "mounica.patnana@gmail.com",
    "requiredEnvVars": [
      "LLM_PROVIDER",
      "LLM_MODEL",
      "GEMINI_API_KEY",
      "SUPABASE_URL",
      "SUPABASE_ANON_KEY",
      "SUPABASE_STORAGE_BUCKET",
      "INDIAN_KANOON_API_TOKEN",
      "CORS_ORIGINS",
      "RESULTS_DIR",
      "FAISS_DIR",
      "CHUNK_PAGES",
      "EMBED_MODEL",
      "PDF_WATERMARK",
      "CLERK_DOMAIN",
      "SUPABASE_SERVICE_KEY",
      "SUPABASE_DB_URL",
      "GROQ_API_KEY",
      "RAZORPAY_KEY_ID",
      "RAZORPAY_KEY_SECRET",
      "RAZORPAY_WEBHOOK_SECRET",
      "ADMIN_API_KEY",
      "OTP_HASH_SECRET",
      "WHATSAPP_PHONE_NUMBER_ID",
      "WHATSAPP_OTP_TEMPLATE",
      "WHATSAPP_CLOUD_TOKEN",
      "CLERK_SECRET_KEY"
    ],
    "frontend": {
      "name": "casemaster-fe",
      "displayName": "CaseMaster AI Frontend",
      "githubRepo": "casemaster-code/casemaster-fe",
      "githubBranch": "master",
      "environments": ["dev"],
      "domains": {
        "dev": "casemaster.co.in"
      },
      "frontendEnvVars": [
        "VITE_API_BASE_URL",
        "VITE_CLERK_PUBLISHABLE_KEY",
        "VITE_SUPABASE_URL",
        "VITE_SUPABASE_ANON_KEY",
        "VITE_RAZORPAY_KEY_ID"
      ]
    }
  }
}
